# /etc/backup-server/backup-server.env
# chmod 600, chown root:root
# 이 파일은 git에 커밋하지 않는다. 실제 값을 채운 뒤 서버에 직접 배치한다.

DB_URL=jdbc:mariadb://DB_HOST:3306/backup
DB_USER=backup_app
DB_PASSWORD=CHANGE_ME

BACKUP_JWT_SECRET=CHANGE_ME_256BIT_RANDOM_STRING

BACKUP_INCOMING_ROOT=/var/backup/incoming
BACKUP_ARTIFACTS_ROOT=/var/backup/artifacts
BACKUP_TRASH_ROOT=/var/backup/trash
